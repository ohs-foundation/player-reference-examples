        }
      ]
    },
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-templateExtract",
      "extension": [
        {
          "url": "template",
          "valueReference": {
            "reference": "#muac-template"
          }
        },
        {
          "url": "resourceId",
          "valueString": "%muacId"
        }
      ]
    }
  ],
