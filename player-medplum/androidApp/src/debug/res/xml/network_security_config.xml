<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY. The dev Medplum stack is plain HTTP on a LAN IP, and API 28+ blocks cleartext
  by default. Scoped to specific dev hosts rather than a blanket base-config, so a stray
  http:// call to anywhere else still fails loudly.

  192.168.8.22 is this machine's LAN IP, as detected by medplum/up.sh. If your IP changes,
  up.sh re-renders the server config and you must change it here and in local.properties too.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">192.168.8.22</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>
</network-security-config>
